# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control (it is listed in .gitignore).

# ─── Razorpay API Keys ────────────────────────────────────────────────────────
# Get test keys at: https://dashboard.razorpay.com → Settings → API Keys
# Test prefix: rzp_test_   |   Live prefix: rzp_live_
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# ─── Runtime Mode ─────────────────────────────────────────────────────────────
# "test" for Razorpay sandbox, "live" for production
RAZORPAY_MODE=test

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development

# true  = use local mock (no API calls, no real money)
# false = use real Razorpay SDK
MOCK_MODE=false

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN_SECRET=REPLACE_WITH_RANDOM_SECRET

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
